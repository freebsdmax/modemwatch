#!/bin/sh /etc/rc.common
# modemwatch init script for OpenWrt procd

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/modemwatch.sh daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/modemwatch
	procd_close_instance
}

reload_service() {
	stop
	start
}
