msgstr "HTTP URL"

msgid "WAN interface"
msgstr "WAN sąsaja"

msgid "The device name is read from network.<iface>.device."
msgstr "Įrenginio pavadinimas nuskaitomas iš tinklo.<iface>.device."

msgid "AT serial port"
msgstr "AT nuosekliajame prievade"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Aptikti USB / ACM nuoseklieji prievadai. Quectel EC200A naudokite /dev/ttyUSB2; /dev/ttyUSB0 yra diagnostikos prievadas ir neatsako į AT komandas."

msgid "AT port baud rate"
msgstr "AT prievado perdavimo sparta"

msgid "Modem reboot method"
msgstr "Modemo perkrovimo metodas"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (rekomenduojama)"

msgid "USB re-bind (best effort)"
msgstr "USB perrišimas (geriausios pastangos)"

msgid "Wait after reboot (seconds)"
msgstr "Palaukite po perkrovimo (sekundėmis)"

msgid "Collect modem information"
msgstr "Surinkite informaciją apie modemą"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Nuskaito modelį, programinę-aparatinę įrangą, IMEI, signalą, operatorių ir temperatūrą per AT komandas."

msgid "Modem info interval (seconds)"
msgstr "Modemo informacijos intervalas (sekundėmis)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Kaip dažnai užklausti modemą naudojant AT komandas. Laikykite jį ilgiau, jei kiti modemo įrankiai naudoja tą patį nuoseklųjį prievadą."

msgid "Signal refresh interval (seconds)"
msgstr "Signalo atnaujinimo intervalas (sekundėmis)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pauzė tarp signalo puslapio atnaujinimų. Tikrasis atnaujinimas taip pat apima modemo atsako laiką."

msgid "Band rollback timeout (seconds)"
msgstr "Juostos atkūrimo skirtasis laikas (sekundėmis)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Jei naujas dažnių juostų rinkinys atjungia internetą, po kelių sekundžių atkurkite ankstesnes juostas. Nustatykite 0, kad išjungtumėte automatinį atšaukimą."

msgid "Safety"
msgstr "Saugumas"

msgid "Maximum reboots per window"
msgstr "Maksimalus paleidimų skaičius viename lange"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Nustatykite 0, kad būtų neribota. Riba neleidžia iš naujo paleisti kilpų."

msgid "Reboot window (seconds)"
msgstr "Iš naujo paleisti langą (sekundėmis)"

msgid "Cooldown between reboots (seconds)"
msgstr "Atvėsimas tarp paleidimų iš naujo (sekundėmis)"

