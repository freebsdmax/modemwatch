msgstr "Įgalinti paslaugą"

msgid "Check interval (seconds)"
msgstr "Tikrinimo intervalas (sekundėmis)"

msgid "Failures before modem reboot"
msgstr "Gedimai prieš modemo paleidimą iš naujo"

msgid "Ping hosts"
msgstr "Ping šeimininkai"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "Tarpais atskirtas sąrašas. Internetas laikomas prieinamu, jei atsako bent vienas pagrindinis kompiuteris."

msgid "Also require DNS resolution"
msgstr "Taip pat reikalingas DNS sprendimas"

msgid "DNS name to resolve"
msgstr "DNS vardas, kurį reikia išspręsti"

msgid "Also require an HTTP request"
msgstr "Taip pat reikia HTTP užklausos"

