msgstr "सेवा पुन्हा सुरू केली"

msgid "Modem info updated"
msgstr "मोडेम माहिती अपडेट केली"

msgid "Modem did not respond"
msgstr "मोडेमने प्रतिसाद दिला नाही"

msgid "Checks internet connectivity and reboots the Quectel modem when the connection is lost."
msgstr "इंटरनेट कनेक्टिव्हिटी तपासते आणि कनेक्शन तुटल्यावर Quectel मोडेम रीबूट करते."

msgid "Service settings"
msgstr "सेवा सेटिंग्ज"

msgid "Enable service"
msgstr "सेवा सक्षम करा"

msgid "Check interval (seconds)"
msgstr "मध्यांतर तपासा (सेकंद)"

msgid "Failures before modem reboot"
msgstr "मोडेम रीबूट करण्यापूर्वी अयशस्वी"

msgid "Ping hosts"
msgstr "पिंग यजमान"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "जागा-विभक्त यादी. किमान एक होस्ट प्रतिसाद देत असल्यास इंटरनेटचा विचार केला जातो."

msgid "Also require DNS resolution"
msgstr "DNS रिझोल्यूशन देखील आवश्यक आहे"

msgid "DNS name to resolve"
msgstr "निराकरण करण्यासाठी DNS नाव"

msgid "Also require an HTTP request"
msgstr "HTTP विनंती देखील आवश्यक आहे"

msgid "HTTP URL"
msgstr "HTTP URL"

msgid "WAN interface"
msgstr "WAN इंटरफेस"

msgid "The device name is read from network.<iface>.device."
msgstr "डिव्हाइसचे नाव नेटवर्कवरून वाचले जाते.<iface>.device."

msgid "AT serial port"
msgstr "एटी सिरीयल पोर्ट"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "USB/ACM सिरीयल पोर्ट आढळले. Quectel EC200A साठी /dev/ttyUSB2 वापरा; /dev/ttyUSB0 हे डायग्नोस्टिक पोर्ट आहे आणि ते AT आदेशांना उत्तर देत नाही."

msgid "AT port baud rate"
msgstr "एटी पोर्ट बॉड दर"

msgid "Modem reboot method"
msgstr "मोडेम रीबूट पद्धत"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (शिफारस केलेले)"

msgid "USB re-bind (best effort)"
msgstr "यूएसबी री-बाइंड (सर्वोत्तम प्रयत्न)"

msgid "Wait after reboot (seconds)"
msgstr "रीबूट केल्यानंतर प्रतीक्षा करा (सेकंद)"

msgid "Collect modem information"
msgstr "मोडेम माहिती गोळा करा"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "एटी कमांडद्वारे मॉडेल, फर्मवेअर, आयएमईआय, सिग्नल, ऑपरेटर आणि तापमान वाचते."

msgid "Modem info interval (seconds)"
msgstr "मोडेम माहिती अंतराल (सेकंद)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "AT कमांडसह मॉडेमची किती वेळा चौकशी करायची. इतर मोडेम साधने समान सिरीयल पोर्ट वापरत असल्यास ते जास्त काळ ठेवा."

msgid "Signal refresh interval (seconds)"
msgstr "सिग्नल रिफ्रेश मध्यांतर (सेकंद)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "सिग्नल पेज अपडेट्स दरम्यान विराम द्या. वास्तविक अपडेटमध्ये मोडेम प्रतिसाद वेळ देखील समाविष्ट आहे."

msgid "Band rollback timeout (seconds)"
msgstr "बँड रोलबॅक टाइमआउट (सेकंद)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "नवीन बँड सेटने इंटरनेट डिस्कनेक्ट केल्यास, या अनेक सेकंदांनंतर मागील बँड पुनर्संचयित करा. स्वयंचलित रोलबॅक अक्षम करण्यासाठी 0 वर सेट करा."

msgid "Safety"
msgstr "सुरक्षितता"

msgid "Maximum reboots per window"
msgstr "प्रति विंडो कमाल रीबूट"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "अमर्यादित साठी 0 वर सेट करा. मर्यादा रीबूट लूप प्रतिबंधित करते."

msgid "Reboot window (seconds)"
msgstr "विंडो रीबूट करा (सेकंद)"

msgid "Cooldown between reboots (seconds)"
msgstr "रीबूट दरम्यान कूलडाउन (सेकंद)"

