msgid "The device name is read from network.<iface>.device."
msgstr "Il nome del dispositivo viene letto dalla rete.<iface>.device."

msgid "AT serial port"
msgstr "Porta seriale AT"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Rilevate porte seriali USB/ACM. Per Quectel EC200A utilizzare /dev/ttyUSB2; /dev/ttyUSB0 è la porta diagnostica e non risponde ai comandi AT."

msgid "AT port baud rate"
msgstr "Velocità di trasmissione della porta AT"

msgid "Modem reboot method"
msgstr "Metodo di riavvio del modem"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (consigliato)"

msgid "USB re-bind (best effort)"
msgstr "Riassociazione USB (massimo sforzo)"

msgid "Wait after reboot (seconds)"
msgstr "Attendi dopo il riavvio (secondi)"

msgid "Collect modem information"
msgstr "Raccogliere informazioni sul modem"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Legge modello, firmware, IMEI, segnale, operatore e temperatura tramite comandi AT."

msgid "Modem info interval (seconds)"
msgstr "Intervallo informazioni modem (secondi)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "La frequenza con cui interrogare il modem con i comandi AT. Conservatelo più a lungo se altri strumenti modem utilizzano la stessa porta seriale."

msgid "Signal refresh interval (seconds)"
msgstr "Intervallo di aggiornamento del segnale (secondi)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pausa tra gli aggiornamenti della pagina del segnale. L'aggiornamento vero e proprio include anche il tempo di risposta del modem."

msgid "Safety"
msgstr "Sicurezza"

msgid "Maximum reboots per window"
msgstr "Numero massimo di riavvii per finestra"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Impostato su 0 per illimitato. Il limite impedisce cicli di riavvio."

msgid "Reboot window (seconds)"
msgstr "Finestra di riavvio (secondi)"

msgid "Cooldown between reboots (seconds)"
msgstr "Tempo di recupero tra i riavvii (secondi)"

