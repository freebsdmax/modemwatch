msgid "Modem LTE 4G"
msgstr "ໂມເດັມ LTE 4G"

msgid "Status"
msgstr "ສະຖານະ"

msgid "Signal"
msgstr "ສັນຍານ"

msgid "Log"
msgstr "ບັນທຶກການເຮັດວຽກ"

msgid "Modem settings"
msgstr "ການຕັ້ງຄ່າໂມເດັມ"

msgid "Network search"
msgstr "ຄົ້ນຫາເຄືອຂ່າຍ"

msgid "Settings"
msgstr "ການຕັ້ງຄ່າ"

msgid "invalid token"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ"

msgid "empty AT command"
msgstr "ຄໍາສັ່ງ AT ຫວ່າງເປົ່າ"

msgid "invalid band selection"
msgstr "ການເລືອກແຖບບໍ່ຖືກຕ້ອງ"

msgid "Band settings sent"
msgstr "ສົ່ງການຕັ້ງຄ່າແຖບແລ້ວ"

msgid "network scan started"
msgstr "ເລີ່ມການສະແກນເຄືອຂ່າຍແລ້ວ"

msgid "network scan stopped"
msgstr "ການສະແກນເຄືອຂ່າຍຢຸດ"

msgid "invalid operator"
msgstr "ຜູ້ປະກອບການບໍ່ຖືກຕ້ອງ"

msgid "Downloading MCC/MNC list"
msgstr "ກຳລັງດາວໂຫຼດລາຍຊື່ MCC/MNC"

msgid "Parsing MCC/MNC list"
msgstr "ກຳລັງວິເຄາະລາຍຊື່ MCC/MNC"

msgid "MCC/MNC database updated"
msgstr "ອັບເດດຖານຂໍ້ມູນ MCC/MNC ແລ້ວ"

msgid "Failed to update MCC/MNC database"
msgstr "ລົ້ມເຫລວໃນການອັບເດດຖານຂໍ້ມູນ MCC/MNC"

msgid "MCC/MNC update already running"
msgstr "ອັບເດດ MCC/MNC ເຮັດວຽກຢູ່ກ່ອນແລ້ວ"

msgid "MCC/MNC update started"
msgstr "ການອັບເດດ MCC/MNC ເລີ່ມແລ້ວ"

msgid "operator selection sent"
msgstr "ການ​ເລືອກ​ຜູ້​ປະ​ຕິ​ບັດ​ການ​ຖືກ​ສົ່ງ​ໄປ​"

msgid "internet check started"
msgstr "ການກວດສອບອິນເຕີເນັດໄດ້ເລີ່ມຕົ້ນ"

msgid "modem reboot started"
msgstr "ເລີ່ມເປີດໂມເດັມຄືນໃໝ່"

msgid "service restarted"
msgstr "ການບໍລິການເລີ່ມຕົ້ນໃໝ່"

msgid "Modem info updated"
msgstr "ອັບເດດຂໍ້ມູນໂມເດັມແລ້ວ"

msgid "Modem did not respond"
msgstr "ໂມເດັມບໍ່ຕອບສະໜອງ"

msgid "Checks internet connectivity and reboots the Quectel modem when the connection is lost."
msgstr "ກວດເບິ່ງການເຊື່ອມຕໍ່ອິນເຕີເນັດ ແລະປິດເປີດໂມເດັມ Quectel ຄືນໃໝ່ເມື່ອການເຊື່ອມຕໍ່ເສຍ."

msgid "Service settings"
msgstr "ການຕັ້ງຄ່າການບໍລິການ"

msgid "Enable service"
msgstr "ເປີດໃຊ້ການບໍລິການ"

msgid "Check interval (seconds)"
msgstr "ກວດສອບໄລຍະຫ່າງ (ວິນາທີ)"

msgid "Failures before modem reboot"
msgstr "ຄວາມລົ້ມເຫຼວກ່ອນທີ່ຈະປິດເປີດໂມເດັມ"

msgid "Ping hosts"
msgstr "Ping ເຈົ້າພາບ"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "ບັນຊີລາຍຊື່ທີ່ແຍກອອກຈາກພື້ນທີ່. ອິນເຕີເນັດແມ່ນພິຈາລະນາເພີ່ມຂຶ້ນຖ້າຫາກວ່າຢ່າງຫນ້ອຍຫນຶ່ງເຈົ້າພາບຕອບສະຫນອງ."

msgid "Also require DNS resolution"
msgstr "ຍັງຕ້ອງການການແກ້ໄຂ DNS"

msgid "DNS name to resolve"
msgstr "ຊື່ DNS ເພື່ອແກ້ໄຂ"

msgid "Also require an HTTP request"
msgstr "ຍັງຕ້ອງການການຮ້ອງຂໍ HTTP"

msgid "HTTP URL"
msgstr "HTTP URL"

msgid "WAN interface"
msgstr "ການໂຕ້ຕອບ WAN"

msgid "The device name is read from network.<iface>.device."
msgstr "ຊື່ອຸປະກອນຖືກອ່ານຈາກເຄືອຂ່າຍ.<iface>.device."

msgid "AT serial port"
msgstr "AT ພອດ serial"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "ກວດພົບພອດ USB/ACM serial. ສໍາລັບ Quectel EC200A ໃຊ້ /dev/ttyUSB2; /dev/ttyUSB0 ແມ່ນພອດກວດວິນິດໄສແລະບໍ່ຕອບຄໍາສັ່ງ AT."

msgid "AT port baud rate"
msgstr "ອັດຕາ AT port baud"

msgid "Modem reboot method"
msgstr "ວິທີການປິດເປີດໂມເດັມ"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (ແນະນຳ)"

msgid "USB re-bind (best effort)"
msgstr "ຜູກມັດ USB ຄືນໃໝ່ (ພະຍາຍາມດີທີ່ສຸດ)"

msgid "Wait after reboot (seconds)"
msgstr "ລໍຖ້າຫຼັງຈາກປິດເປີດໃໝ່ (ວິນາທີ)"

msgid "Collect modem information"
msgstr "ເກັບກໍາຂໍ້ມູນໂມເດັມ"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "ອ່ານຕົວແບບ, ເຟີມແວ, IMEI, ສັນຍານ, ຕົວປະຕິບັດການ ແລະອຸນຫະພູມຜ່ານຄຳສັ່ງ AT."

msgid "Modem info interval (seconds)"
msgstr "ໄລຍະຫ່າງຂໍ້ມູນໂມເດັມ (ວິນາທີ)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "ການສອບຖາມໂມເດັມດ້ວຍຄຳສັ່ງ AT ເລື້ອຍໆສໍ່າໃດ. ຮັກສາມັນໄວ້ດົນກວ່າຖ້າເຄື່ອງມືໂມເດັມອື່ນໃຊ້ພອດ serial ດຽວກັນ."

msgid "Signal refresh interval (seconds)"
msgstr "ໄລຍະການໂຫຼດຂໍ້ມູນຄືນໃໝ່ (ວິນາທີ)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "ຢຸດຊົ່ວຄາວລະຫວ່າງການປັບປຸງຫນ້າສັນຍານ. ການປັບປຸງຕົວຈິງຍັງປະກອບມີເວລາຕອບສະຫນອງໂມເດັມ."

msgid "Safety"
msgstr "ຄວາມປອດໄພ"

msgid "Maximum reboots per window"
msgstr "reboots ສູງສຸດຕໍ່ປ່ອງຢ້ຽມ"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "ກໍານົດເປັນ 0 ສໍາລັບການບໍ່ຈໍາກັດ. ຂອບເຂດຈໍາກັດປ້ອງກັນການ reboot loops."

msgid "Reboot window (seconds)"
msgstr "reboot window (ວິນາທີ)"

msgid "Cooldown between reboots (seconds)"
msgstr "Cooldown ລະຫວ່າງ reboots (ວິນາທີ)"

msgid "Logging"
msgstr "ການບັນທຶກຂໍ້ມູນ"

msgid "Log level"
msgstr "ລະດັບການບັນທຶກ (Log)"

msgid "Error"
msgstr "ຄວາມຜິດພາດ"

msgid "Warning"
msgstr "Warning"

msgid "Info"
msgstr "ຂໍ້ມູນ"

msgid "Debug"
msgstr "ດີບັກ (Debug)"

msgid "Remote access warning"
msgstr "ການເຕືອນໄພການເຂົ້າເຖິງໄລຍະໄກ"

msgid "This service reboots only the modem, not the router. If the modem is the only WAN, internet and remote access will be down during the reboot. Do not change USB mode, APN or band settings remotely without a rollback plan."
msgstr "ການບໍລິການນີ້ reboots ພຽງແຕ່ໂມເດັມ, ບໍ່ແມ່ນ router. ຖ້າໂມເດັມເປັນ WAN ເທົ່ານັ້ນ, ອິນເຕີເນັດ ແລະການເຂົ້າເຖິງທາງໄກຈະຫຼຸດລົງໃນລະຫວ່າງການປິດເປີດໃໝ່. ຢ່າປ່ຽນໂຫມດ USB, APN ຫຼືການຕັ້ງຄ່າແຖບຈາກໄລຍະໄກໂດຍບໍ່ມີແຜນການ rollback."

