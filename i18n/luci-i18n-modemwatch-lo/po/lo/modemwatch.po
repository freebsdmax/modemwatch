msgstr "ຢຸດຊົ່ວຄາວ"

msgid "Busy"
msgstr "ບໍ່ຫວ່າງ"

msgid "AT port not found"
msgstr "ບໍ່ພົບພອດ AT"

msgid "No response from modem"
msgstr "ບໍ່ມີການຕອບສະໜອງຈາກໂມເດັມ"

msgid "Failed to read signal"
msgstr "ອ່ານສັນຍານບໍ່ສຳເລັດ"

msgid "Resume"
msgstr "ປະຫວັດຫຍໍ້"

msgid "Refresh log"
msgstr "ໂຫຼດບັນທຶກຄືນໃໝ່"

msgid "Auto-refresh"
msgstr "ໂຫຼດຂໍ້ມູນຄືນໃໝ່ອັດຕະໂນມັດ"

msgid "(empty)"
msgstr "(ຫວ່າງເປົ່າ)"

msgid "Updated"
msgstr "ອັບເດດ"

