msgstr "Methode voor het opnieuw opstarten van de modem"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (aanbevolen)"

msgid "USB re-bind (best effort)"
msgstr "USB opnieuw binden (beste poging)"

msgid "Wait after reboot (seconds)"
msgstr "Wacht na opnieuw opstarten (seconden)"

msgid "Collect modem information"
msgstr "Verzamel modeminformatie"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Leest model, firmware, IMEI, signaal, operator en temperatuur via AT-opdrachten."

msgid "Modem info interval (seconds)"
msgstr "Modem-info-interval (seconden)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Hoe vaak de modem moet worden opgevraagd met AT-opdrachten. Bewaar deze langer als andere modemtools dezelfde seriële poort gebruiken."

msgid "Signal refresh interval (seconds)"
msgstr "Signaalvernieuwingsinterval (seconden)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pauzeer tussen signaalpagina-updates. De daadwerkelijke update omvat ook de responstijd van de modem."

msgid "Band rollback timeout (seconds)"
msgstr "Time-out voor terugdraaien van band (seconden)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Als de nieuwe bandset de internetverbinding verbreekt, herstel dan na dit aantal seconden de vorige banden. Stel in op 0 om automatisch terugdraaien uit te schakelen."

msgid "Safety"
msgstr "Veiligheid"

msgid "Maximum reboots per window"
msgstr "Maximaal opnieuw opstarten per venster"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Stel in op 0 voor onbeperkt. De limiet voorkomt herstartlussen."

msgid "Reboot window (seconds)"
msgstr "Herstartvenster (seconden)"

msgid "Cooldown between reboots (seconds)"
msgstr "Afkoeltijd tussen opnieuw opstarten (seconden)"

