msgstr "DNS име за разрешаване"

msgid "Also require an HTTP request"
msgstr "Също така изисква HTTP заявка"

msgid "HTTP URL"
msgstr "HTTP URL"

msgid "WAN interface"
msgstr "WAN интерфейс"

msgid "The device name is read from network.<iface>.device."
msgstr "Името на устройството се чете от мрежата.<iface>.device."

msgid "AT serial port"
msgstr "AT сериен порт"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Открити USB/ACM серийни портове. За Quectel EC200A използвайте /dev/ttyUSB2; /dev/ttyUSB0 е диагностичният порт и не отговаря на AT команди."

msgid "AT port baud rate"
msgstr "AT порт скорост на предаване"

msgid "Modem reboot method"
msgstr "Метод за рестартиране на модема"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (препоръчително)"

msgid "USB re-bind (best effort)"
msgstr "USB повторно обвързване (максимални усилия)"

msgid "Wait after reboot (seconds)"
msgstr "Изчакайте след рестартиране (секунди)"

msgid "Collect modem information"
msgstr "Съберете информация за модема"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Чете модел, фърмуер, IMEI, сигнал, оператор и температура чрез AT команди."

msgid "Modem info interval (seconds)"
msgstr "Информационен интервал за модема (секунди)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Колко често да правите запитвания към модема с AT команди. Запазете го по-дълго, ако други модемни инструменти използват същия сериен порт."

msgid "Signal refresh interval (seconds)"
msgstr "Интервал на опресняване на сигнала (секунди)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Пауза между актуализациите на страницата на сигнала. Действителната актуализация включва и времето за реакция на модема."

msgid "Band rollback timeout (seconds)"
msgstr "Време за изчакване на връщане на лентата (секунди)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Ако новият набор от ленти прекъсне връзката с интернет, възстановете предишните ленти след толкова секунди. Задайте 0, за да деактивирате автоматичното връщане назад."

msgid "Safety"
msgstr "Безопасност"

msgid "Maximum reboots per window"
msgstr "Максимален брой рестартирания на прозорец"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Задайте 0 за неограничен. Ограничението предотвратява цикли при рестартиране."

msgid "Reboot window (seconds)"
msgstr "Прозорец за рестартиране (секунди)"

msgid "Cooldown between reboots (seconds)"
msgstr "Време за изчакване между рестартирания (секунди)"

