msgid "Checks internet connectivity and reboots the Quectel modem when the connection is lost."
msgstr "Проверява интернет връзката и рестартира модема Quectel, когато връзката се загуби."

msgid "Service settings"
msgstr "Сервизни настройки"

msgid "Enable service"
msgstr "Активирайте услугата"

msgid "Check interval (seconds)"
msgstr "Интервал на проверка (секунди)"

msgid "Failures before modem reboot"
msgstr "Грешки преди рестартиране на модема"

msgid "Ping hosts"
msgstr "Пинг хостове"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "Списък, разделен с интервал. Интернет се счита за активен, ако поне един хост отговори."

msgid "Also require DNS resolution"
msgstr "Изисква се и DNS резолюция"

