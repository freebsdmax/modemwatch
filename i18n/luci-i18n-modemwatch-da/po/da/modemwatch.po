msgstr "AT port baudrate"

msgid "Modem reboot method"
msgstr "Modem genstart metode"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (anbefalet)"

msgid "USB re-bind (best effort)"
msgstr "USB-genbinding (bedste indsats)"

msgid "Wait after reboot (seconds)"
msgstr "Vent efter genstart (sekunder)"

msgid "Collect modem information"
msgstr "Indsaml modemoplysninger"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Læser model, firmware, IMEI, signal, operatør og temperatur via AT-kommandoer."

msgid "Modem info interval (seconds)"
msgstr "Modem info interval (sekunder)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Hvor ofte forespørges modemet med AT-kommandoer. Opbevar det længere, hvis andre modemværktøjer bruger den samme serielle port."

msgid "Signal refresh interval (seconds)"
msgstr "Signalopdateringsinterval (sekunder)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pause mellem signalsideopdateringer. Selve opdateringen inkluderer også modemets responstid."

msgid "Band rollback timeout (seconds)"
msgstr "Timeout for bandrulning (sekunder)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Hvis det nye båndsæt afbryder internettet, skal du gendanne de tidligere bånd efter disse mange sekunder. Indstil til 0 for at deaktivere automatisk tilbagerulning."

msgid "Safety"
msgstr "Sikkerhed"

msgid "Maximum reboots per window"
msgstr "Maksimal genstart pr. vindue"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Indstil til 0 for ubegrænset. Grænsen forhindrer genstartsløkker."

msgid "Reboot window (seconds)"
msgstr "Genstartsvindue (sekunder)"

msgid "Cooldown between reboots (seconds)"
msgstr "Nedkøling mellem genstart (sekunder)"

