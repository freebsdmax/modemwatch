msgid "The device name is read from network.<iface>.device."
msgstr "Enhedsnavnet læses fra netværket.<iface>.enhed."

msgid "AT serial port"
msgstr "AT seriel port"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Detekteret USB/ACM serielle porte. Til Quectel EC200A skal du bruge /dev/ttyUSB2; /dev/ttyUSB0 er diagnosticeringsporten og besvarer ikke AT-kommandoer."

