msgstr "AT port ráta baud"

msgid "Modem reboot method"
msgstr "Modh atosaigh móideim"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (molta)"

msgid "USB re-bind (best effort)"
msgstr "Athcheangal USB (an iarracht is fearr)"

