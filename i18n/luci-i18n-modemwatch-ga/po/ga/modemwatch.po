msgstr "Bailigh eolas móideim"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Léann samhail, firmware, IMEI, comhartha, oibreoir agus teocht trí orduithe AT."

msgid "Modem info interval (seconds)"
msgstr "Eatramh faisnéise móideim (soicindí)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Cé chomh minic is féidir an móideim a fhiosrú le horduithe AT. Coinnigh sé níos faide má úsáideann uirlisí móideim eile an port srathach céanna."

msgid "Signal refresh interval (seconds)"
msgstr "Eatramh athnuachana comharthaí (soicindí)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Sos idir nuashonruithe leathanach comhartha. Áiríonn an nuashonrú iarbhír an t-am freagartha móideim freisin."

msgid "Band rollback timeout (seconds)"
msgstr "Teorainn ama rolladh siar banna (soicindí)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Má dhícheanglaíonn an tacar bannaí nua an t-idirlíon, cuir na bannaí roimhe seo ar ais tar éis an iliomad soicind seo. Socraigh go 0 chun rolladh siar uathoibríoch a dhíchumasú."

msgid "Safety"
msgstr "Sábháilteacht"

msgid "Maximum reboots per window"
msgstr "Atosaithe uasta in aghaidh na fuinneoige"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Socraigh ar 0 le haghaidh neamhtheoranta. Cuireann an teorainn cosc ​​ar lúba atosaigh."

msgid "Reboot window (seconds)"
msgstr "Fuinneog atosaigh (soicindí)"

msgid "Cooldown between reboots (seconds)"
msgstr "Fuarú idir atosaithe (soicindí)"

