msgid "The device name is read from network.<iface>.device."
msgstr "Názov zariadenia sa načíta zo siete.<iface>.device."

msgid "AT serial port"
msgstr "AT sériový port"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Zistené sériové porty USB/ACM. Pre Quectel EC200A použite /dev/ttyUSB2; /dev/ttyUSB0 je diagnostický port a neodpovedá na príkazy AT."

msgid "AT port baud rate"
msgstr "Prenosová rýchlosť portu AT"

msgid "Modem reboot method"
msgstr "Metóda reštartu modemu"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (odporúčané)"

msgid "USB re-bind (best effort)"
msgstr "USB re-bind (najlepšie úsilie)"

msgid "Wait after reboot (seconds)"
msgstr "Počkajte po reštarte (sekundy)"

msgid "Collect modem information"
msgstr "Zbierajte informácie o modemoch"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Číta model, firmvér, IMEI, signál, operátora a teplotu pomocou AT príkazov."

msgid "Modem info interval (seconds)"
msgstr "Interval informácií o modemu (sekundy)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Ako často žiadať modem pomocou AT príkazov. Ponechajte ho dlhšie, ak iné modemové nástroje používajú rovnaký sériový port."

msgid "Signal refresh interval (seconds)"
msgstr "Interval obnovy signálu (sekundy)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pauza medzi aktualizáciami signálovej stránky. Aktuálna aktualizácia zahŕňa aj čas odozvy modemu."

msgid "Safety"
msgstr "Bezpečnosť"

msgid "Maximum reboots per window"
msgstr "Maximálny počet reštartov na okno"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Nastavte na 0 pre neobmedzené. Obmedzenie bráni slučkám pri reštarte."

msgid "Reboot window (seconds)"
msgstr "Okno reštartu (sekundy)"

msgid "Cooldown between reboots (seconds)"
msgstr "Vychladnutie medzi reštartmi (sekundy)"

