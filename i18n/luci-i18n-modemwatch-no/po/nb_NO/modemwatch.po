msgid "The device name is read from network.<iface>.device."
msgstr "Enhetsnavnet leses fra nettverket.<iface>.enhet."

msgid "AT serial port"
msgstr "AT seriell port"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Oppdaget USB/ACM-serieporter. For Quectel EC200A bruk /dev/ttyUSB2; /dev/ttyUSB0 er diagnoseporten og svarer ikke på AT-kommandoer."

msgid "AT port baud rate"
msgstr "AT port baud rate"

msgid "Modem reboot method"
msgstr "Metode for omstart av modemet"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (anbefalt)"

msgid "USB re-bind (best effort)"
msgstr "USB re-binding (beste innsats)"

msgid "Wait after reboot (seconds)"
msgstr "Vent etter omstart (sekunder)"

msgid "Collect modem information"
msgstr "Samle inn modeminformasjon"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Leser modell, fastvare, IMEI, signal, operatør og temperatur via AT-kommandoer."

msgid "Modem info interval (seconds)"
msgstr "Modeminformasjonsintervall (sekunder)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Hvor ofte spørre modemet med AT-kommandoer. Behold den lenger hvis andre modemverktøy bruker samme serieport."

msgid "Signal refresh interval (seconds)"
msgstr "Signaloppdateringsintervall (sekunder)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Pause mellom oppdateringer av signalsiden. Selve oppdateringen inkluderer også modemets responstid."

msgid "Band rollback timeout (seconds)"
msgstr "Tidsavbrudd for tilbakerulling av bånd (sekunder)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Hvis det nye båndsettet kobler fra Internett, gjenopprett de forrige båndene etter disse mange sekunder. Sett til 0 for å deaktivere automatisk tilbakeføring."

msgid "Safety"
msgstr "Sikkerhet"

msgid "Maximum reboots per window"
msgstr "Maksimalt antall omstarter per vindu"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Sett til 0 for ubegrenset. Grensen forhindrer omstartsløkker."

msgid "Reboot window (seconds)"
msgstr "Omstartvindu (sekunder)"

msgid "Cooldown between reboots (seconds)"
msgstr "Nedkjøling mellom omstart (sekunder)"

