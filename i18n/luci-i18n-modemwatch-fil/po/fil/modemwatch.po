msgstr "Pinakamataas na pag-reboot bawat window"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Itakda sa 0 para sa walang limitasyon. Pinipigilan ng limitasyon ang mga pag-reboot na loop."

msgid "Reboot window (seconds)"
msgstr "Reboot window (segundo)"

msgid "Cooldown between reboots (seconds)"
msgstr "Cooldown sa pagitan ng mga pag-reboot (segundo)"

