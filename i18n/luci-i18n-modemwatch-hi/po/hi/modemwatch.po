msgstr "ऑपरेटर चयन भेजा गया"

msgid "internet check started"
msgstr "इंटरनेट जांच शुरू हो गई"

msgid "modem reboot started"
msgstr "मॉडेम रीबूट प्रारंभ हुआ"

msgid "service restarted"
msgstr "सेवा पुनः प्रारंभ"

msgid "Modem info updated"
msgstr "मॉडेम जानकारी अद्यतन की गई"

msgid "Modem did not respond"
msgstr "मॉडेम ने कोई उत्तर नहीं दिया"

msgid "Checks internet connectivity and reboots the Quectel modem when the connection is lost."
msgstr "इंटरनेट कनेक्टिविटी की जाँच करता है और कनेक्शन खो जाने पर क्वेक्टेल मॉडेम को रीबूट करता है।"

msgid "Service settings"
msgstr "सेवा सेटिंग्स"

msgid "Enable service"
msgstr "सेवा सक्षम करें"

msgid "Check interval (seconds)"
msgstr "जाँच अंतराल (सेकंड)"

msgid "Failures before modem reboot"
msgstr "मॉडेम रीबूट से पहले विफलताएँ"

msgid "Ping hosts"
msgstr "पिंग होस्ट"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "स्थान-पृथक सूची. यदि कम से कम एक होस्ट उत्तर देता है तो इंटरनेट चालू माना जाता है।"

msgid "Also require DNS resolution"
msgstr "DNS रिज़ॉल्यूशन की भी आवश्यकता है"

msgid "DNS name to resolve"
msgstr "समाधान के लिए DNS नाम"

msgid "Also require an HTTP request"
msgstr "HTTP अनुरोध की भी आवश्यकता है"

msgid "HTTP URL"
msgstr "HTTP URL"

msgid "WAN interface"
msgstr "WAN इंटरफ़ेस"

msgid "The device name is read from network.<iface>.device."
msgstr "डिवाइस का नाम नेटवर्क.<iface>.device से पढ़ा जाता है।"

msgid "AT serial port"
msgstr "एटी सीरियल पोर्ट"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "यूएसबी/एसीएम सीरियल पोर्ट का पता लगाया गया। Quectel EC200A के लिए /dev/ttyUSB2 का उपयोग करें; /dev/ttyUSB0 डायग्नोस्टिक पोर्ट है और एटी कमांड का जवाब नहीं देता है।"

msgid "AT port baud rate"
msgstr "एटी पोर्ट बॉड दर"

msgid "Modem reboot method"
msgstr "मॉडेम रीबूट विधि"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (recommended)"

msgid "USB re-bind (best effort)"
msgstr "USB री-बाइंड (सर्वोत्तम प्रयास)"

msgid "Wait after reboot (seconds)"
msgstr "रिबूट के बाद प्रतीक्षा करें (सेकंड)"

msgid "Collect modem information"
msgstr "मॉडेम जानकारी एकत्रित करें"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "एटी कमांड के माध्यम से मॉडल, फर्मवेयर, आईएमईआई, सिग्नल, ऑपरेटर और तापमान पढ़ता है।"

msgid "Modem info interval (seconds)"
msgstr "मॉडेम सूचना अंतराल (सेकंड)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "एटी कमांड के साथ मॉडेम को कितनी बार क्वेरी करना है। यदि अन्य मॉडेम उपकरण समान सीरियल पोर्ट का उपयोग करते हैं तो इसे अधिक समय तक रखें।"

msgid "Signal refresh interval (seconds)"
msgstr "सिग्नल ताज़ा अंतराल (सेकंड)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "सिग्नल पेज अपडेट के बीच रुकें। वास्तविक अद्यतन में मॉडेम प्रतिक्रिया समय भी शामिल है।"

msgid "Safety"
msgstr "सुरक्षा"

msgid "Maximum reboots per window"
msgstr "प्रति विंडो अधिकतम रीबूट"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "असीमित के लिए 0 पर सेट करें. सीमा रिबूट लूप को रोकती है।"

msgid "Reboot window (seconds)"
msgstr "रीबूट विंडो (सेकंड)"

msgid "Cooldown between reboots (seconds)"
msgstr "रिबूट के बीच कूलडाउन (सेकंड)"

