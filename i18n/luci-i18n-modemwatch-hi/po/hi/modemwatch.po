msgstr "एमसीसी/एमएनसी डेटाबेस अद्यतन करने में विफल"

msgid "MCC/MNC update already running"
msgstr "एमसीसी/एमएनसी अपडेट पहले से चल रहा है"

msgid "MCC/MNC update started"
msgstr "एमसीसी/एमएनसी अद्यतन प्रारंभ हुआ"

