msgstr "डिफ़ॉल्ट पुनर्स्थापित करें"

msgid "Apply bands"
msgstr "बैंड लगाएं"

msgid "Select the LTE bands you want to keep enabled. Applying may restart the WAN and drop the connection."
msgstr "वह LTE बैंड चुनें जिसे आप सक्षम रखना चाहते हैं। आवेदन करने से WAN पुनः प्रारंभ हो सकता है और कनेक्शन टूट सकता है।"

msgid "USB mode"
msgstr "यूएसबी मोड"

msgid "Current value"
msgstr "वर्तमान मूल्य"

msgid "New value"
msgstr "नया मूल्य"

msgid "RMNET (QMI)"
msgstr "RMNET (QMI)"

msgid "not supported"
msgstr "समर्थित नहीं"

msgid "ECM (CDC Ethernet)"
msgstr "ईसीएम (सीडीसी ईथरनेट)"

msgid "MBIM"
msgstr "MBIM"

msgid "RNDIS"
msgstr "RNDIS"

msgid "Apply USB mode"
msgstr "यूएसबी मोड लागू करें"

msgid "Read USB mode"
msgstr "USB मोड पढ़ें"

msgid "Modes that are not supported by the modem firmware are disabled and marked as not supported. Supported modes are detected automatically from the modem."
msgstr "जो मोड मॉडेम फ़र्मवेयर द्वारा समर्थित नहीं हैं, उन्हें अक्षम कर दिया गया है और समर्थित नहीं के रूप में चिह्नित किया गया है। समर्थित मोड का मॉडेम से स्वचालित रूप से पता लगाया जाता है।"

msgid "Apply NAT"
msgstr "NAT लागू करें"

msgid "Read NAT"
msgstr "NAT पढ़ें"

