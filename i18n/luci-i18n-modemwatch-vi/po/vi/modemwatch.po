msgstr "Tên DNS để giải quyết"

msgid "Also require an HTTP request"
msgstr "Cũng yêu cầu một yêu cầu HTTP"

msgid "HTTP URL"
msgstr "HTTP URL"

msgid "WAN interface"
msgstr "giao diện WAN"

msgid "The device name is read from network.<iface>.device."
msgstr "Tên thiết bị được đọc từ mạng.<iface>.device."

msgid "AT serial port"
msgstr "Cổng nối tiếp AT"

msgid "Detected USB/ACM serial ports. For Quectel EC200A use /dev/ttyUSB2; /dev/ttyUSB0 is the diagnostic port and does not answer AT commands."
msgstr "Đã phát hiện cổng nối tiếp USB/ACM. Đối với Quectel EC200A, hãy sử dụng /dev/ttyUSB2; /dev/ttyUSB0 là cổng chẩn đoán và không trả lời các lệnh AT."

msgid "AT port baud rate"
msgstr "Tốc độ truyền của cổng AT"

msgid "Modem reboot method"
msgstr "Phương pháp khởi động lại modem"

msgid "AT+CFUN=1,1 (recommended)"
msgstr "AT+CFUN=1,1 (được khuyến nghị)"

msgid "USB re-bind (best effort)"
msgstr "Liên kết lại USB (nỗ lực tốt nhất)"

msgid "Wait after reboot (seconds)"
msgstr "Đợi sau khi khởi động lại (giây)"

msgid "Collect modem information"
msgstr "Thu thập thông tin modem"

msgid "Reads model, firmware, IMEI, signal, operator and temperature via AT commands."
msgstr "Đọc model, firmware, IMEI, tín hiệu, toán tử và nhiệt độ thông qua lệnh AT."

msgid "Modem info interval (seconds)"
msgstr "Khoảng thời gian thông tin modem (giây)"

msgid "How often to query the modem with AT commands. Keep it longer if other modem tools use the same serial port."
msgstr "Tần suất truy vấn modem bằng lệnh AT. Giữ nó lâu hơn nếu các công cụ modem khác sử dụng cùng một cổng nối tiếp."

msgid "Signal refresh interval (seconds)"
msgstr "Khoảng thời gian làm mới tín hiệu (giây)"

msgid "Pause between signal page updates. The actual update also includes the modem response time."
msgstr "Tạm dừng giữa các lần cập nhật trang tín hiệu. Bản cập nhật thực tế cũng bao gồm thời gian phản hồi của modem."

msgid "Band rollback timeout (seconds)"
msgstr "Thời gian chờ khôi phục băng tần (giây)"

msgid "If the new band set disconnects the internet, restore the previous bands after this many seconds. Set to 0 to disable automatic rollback."
msgstr "Nếu băng tần mới ngắt kết nối Internet, hãy khôi phục các băng tần trước đó sau nhiều giây. Đặt thành 0 để tắt tính năng khôi phục tự động."

msgid "Safety"
msgstr "An toàn"

msgid "Maximum reboots per window"
msgstr "Số lần khởi động lại tối đa trên mỗi cửa sổ"

msgid "Set to 0 for unlimited. The limit prevents reboot loops."
msgstr "Đặt thành 0 cho không giới hạn. Giới hạn ngăn chặn các vòng lặp khởi động lại."

msgid "Reboot window (seconds)"
msgstr "Cửa sổ khởi động lại (giây)"

msgid "Cooldown between reboots (seconds)"
msgstr "Thời gian hồi chiêu giữa các lần khởi động lại (giây)"

