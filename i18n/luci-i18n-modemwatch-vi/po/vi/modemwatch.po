msgstr "Lỗi trước khi khởi động lại modem"

msgid "Ping hosts"
msgstr "Máy chủ Ping"

msgid "Space-separated list. Internet is considered up if at least one host responds."
msgstr "Danh sách được phân tách bằng dấu cách. Internet được coi là hoạt động nếu có ít nhất một máy chủ phản hồi."

msgid "Also require DNS resolution"
msgstr "Cũng yêu cầu độ phân giải DNS"

